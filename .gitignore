# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/
.env

# --- CFD simulator generated outputs (PNG/CSV/Tecplot/HDF5, run logs) ---
# Ignore the regenerable frame dumps written at runtime, but keep the
# rendered animation deliverables that are force-added as published
# artifacts: .mp4 under CFDPYGPU/outputs/ and .wmv under CFDPY/outputs/.
# (Tracked files bypass .gitignore regardless; these negations document
# intent and keep the deliverables out of the "ignored" set for newcomers.)
**/outputs/**
!**/outputs/
!**/outputs/**/*.mp4
!**/outputs/**/*.wmv

# --- Chapter program figures ---
# Each chapter program saves one PNG (figN_M_<name>.png) into the current
# working directory; they are regenerated by re-running the script.
fig*.png

# --- Scratch / transient debug files ---
_vel_check.json
_vel_out.txt
*_run.log
*_run_ext.log

# --- Editors / OS / local tooling ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/