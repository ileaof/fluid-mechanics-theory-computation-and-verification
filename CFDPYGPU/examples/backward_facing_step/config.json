{
    "name": "backward_facing_step",

    "Nx": 170,
    "Ny": 40,
    "Nz": 1,
    "Lx": 17.0,
    "Ly": 2.0,
    "Lz": 1.0,

    "dt": 0.02,
    "tfinal": 40.0,
    "time_scheme": "crank-nicolson",
    "adaptive_dt": true,
    "cfl_max": 0.4,
    "dt_min": 1e-6,
    "dt_max": 0.05,

    "rho": 1.0,
    "mu": 0.01,
    "cp": 1.0,
    "k": 0.0,
    "beta": 0.0,
    "gravity": [0.0, 0.0, 0.0],

    "boussinesq": false,
    "nondimensional": true,
    "reference_scales": {
        "note": "Unit-scaled benchmark: rho=1, U=1, step height h=1 so Re_h = rho*U*h/mu = 1/mu.",
        "Re_h": 100, "length_scale": "h (step height)", "velocity_scale": "U (inlet)",
        "density_scale": "rho", "to_SI": "multiply by chosen physical h[m], U[m/s], rho[kg/m^3]"
    },

    "use_vof": false,

    "convection": "upwind",
    "limiter": "vanleer",
    "linear_solver": "bicgstab",
    "linear_tol": 1e-6,
    "linear_maxiter": 1000,
    "poisson_tol": 1e-7,
    "poisson_maxiter": 3000,
    "use_ilu": true,

    "velocity_bc": {
        "west":  {"kind": "inlet", "value": 1.0},
        "east":  "outlet",
        "south": "no-slip",
        "north": "no-slip"
    },
    "temperature_bc": {
        "west": "adiabatic", "east": "adiabatic",
        "south": "adiabatic", "north": "adiabatic"
    },
    "pressure_bc": {
        "west": "neumann", "east": "neumann",
        "south": "neumann", "north": "neumann"
    },

    "obstacles": [
        {"x0": 0.0, "x1": 2.0, "y0": 0.0, "y1": 1.0}
    ],

    "t0": 300.0,
    "u0": 1.0,
    "v0": 0.0,
    "w0": 0.0,

    "output_dir": "outputs/backward_facing_step",
    "output_interval": 0.5,
    "save_csv": true,
    "save_hdf5": true,
    "save_tecplot": true,
    "save_png": true,
    "save_mp4": true,
    "verbose": true,
    "plot_interval": 10
}