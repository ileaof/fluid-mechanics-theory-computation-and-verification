{
    "name": "natural_convection_2D",
    "Nx": 60,
    "Ny": 60,
    "Nz": 1,
    "Lx": 1.0,
    "Ly": 1.0,
    "Lz": 1.0,

    "dt": 0.01,
    "tfinal": 8.0,
    "time_scheme": "crank-nicolson",
    "adaptive_dt": false,

    "rho": 1.0,
    "mu": 2.13e-3,
    "cp": 1.0,
    "k": 3.0e-3,
    "beta": 1.3038e-3,
    "t_ref": 325.0,
    "gravity": [0.0, -9.81, 0.0],

    "boussinesq": true,
    "nondimensional": true,
    "reference_scales": {
        "note": "de Vahl Davis cavity in scaled variables: rho=1, cp=1, L=1; Pr=mu*cp/k, Ra=g*beta*dT*L^3/(nu*alpha).",
        "Ra": 1.0e5, "Pr": 0.71, "length_scale": "L (cavity side)",
        "temperature_scale": "dT = T_hot - T_cold [K]", "note2": "T is still reported in kelvin (SI)."
    },

    "use_vof": false,

    "convection": "upwind",
    "limiter": "vanleer",
    "linear_solver": "bicgstab",
    "linear_tol": 1e-6,
    "linear_maxiter": 1000,
    "poisson_tol": 1e-7,
    "poisson_maxiter": 2000,

    "velocity_bc": {
        "west":  "no-slip",
        "east":  "no-slip",
        "south": "no-slip",
        "north": "no-slip"
    },
    "temperature_bc": {
        "west":  {"kind": "fixed", "value": 350.0},
        "east":  {"kind": "fixed", "value": 300.0},
        "south": "adiabatic",
        "north": "adiabatic"
    },
    "pressure_bc": {
        "west": "neumann", "east": "neumann",
        "south": "neumann", "north": "neumann"
    },

    "t0": 325.0,
    "u0": 0.0,
    "v0": 0.0,
    "w0": 0.0,

    "output_dir": "outputs/natural_convection_2D",
    "output_interval": 0.4,
    "save_csv": true,
    "save_hdf5": true,
    "save_tecplot": true,
    "save_png": true,
    "save_mp4": true,
    "verbose": true,
    "plot_interval": 10
}